      "typeVersion": 1.2,
      "position": [
        864,
        448
      ],
      "id": "embed-1",
      "name": "Embeddings"
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\\n  \"reply\": \"\",\\n  \"needs_human\": false,\\n  \"escalation_reason\": \"\",\\n  \"lead_name\": \"\",\\n  \"lead_email\": \"\",\\n  \"lead_company\": \"\",\\n  \"lead_intent\": \"\"\\n}",
        "autoFix": true
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        704,
        448
      ],
      "id": "parser-1",
      "name": "Structured Output"
    },
    {
      "parameters": {
        "jsCode": "const source = $input.first().json;\\nconst parsed = source.output && typeof source.output === 'object' ? source.output : source;\\nreturn [{ json: {\\n  session_id: $('Normalize Input').first().json.session_id,\\n  user_message: $('Normalize Input').first().json.message,\\n  reply: parsed.reply || parsed.output || 'I could not generate a response.',\\n  needs_human: Boolean(parsed.needs_human),\\n  escalation_reason: parsed.escalation_reason || '',\\n  lead_name: parsed.lead_name || '',\\n  lead_email: parsed.lead_email || '',\\n  lead_company: parsed.lead_company || '',\\n  lead_intent: parsed.lead_intent || ''\\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "id": "code-1",
      "name": "Normalize Agent Output"
