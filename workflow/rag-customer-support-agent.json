      "typeVersion": 3.4,
      "position": [
        224,
        0
      ],
      "id": "set-1",
      "name": "Normalize Input"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=USER_MESSAGE: {{ $json.message }}\\nSESSION_ID: {{ $json.session_id }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are BrightDesk's customer-support assistant for a fictional SaaS demo. Your job is to answer accurately from the connected knowledge base.\\n\\nRULES\\n1. For questions about BrightDesk products, plans, pricing, billing, policies, integrations, API, security, support, or limits, use the Supabase Vector Store before answering.\\n2. Do not invent company facts. If retrieved context does not support an answer, say you cannot confirm it from the available documentation and set needs_human=true.\\n3. Answer the user's question before asking for lead details.\\n4. If the user asks for a demo, quote, sales call, or follow-up, you may collect name, work email, and company.\\n5. Set needs_human=true for account-specific problems, custom contracts/quotes, or undocumented legal/compliance/security guarantees.\\n6. Keep replies concise and professional.\\n\\nReturn only the structured output required by the parser."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        512,
        0
      ],
      "id": "agent-1",
      "name": "RAG Support Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
